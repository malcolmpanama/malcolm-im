---
import "../styles/global.css";
import ThemeToggle from "../components/ThemeToggle.astro";

interface Props {
  /** Page title. "malcolm.im" is appended automatically, except on the home page. */
  title: string;
  /** Meta description and social card copy. */
  description: string;
  /** Set on the home page so the title is not doubled up. */
  bare?: boolean;
  /** Vertically centre short pages. */
  centered?: boolean;
}

const { title, description, bare = false, centered = false } = Astro.props;

const fullTitle = bare ? title : `${title} · malcolm.im`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// 1200x630 card in public/. Regenerate it if the tagline ever changes.
const socialImage = new URL("/og.png", Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <!-- social cards: without these, sharing a link gives a blank preview -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="malcolm.im" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="malcolm.im" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <meta name="theme-color" content="#fbfaf8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#101012" media="(prefers-color-scheme: dark)" />

    <!-- Resolve the saved theme before first paint so there is no flash. -->
    <script is:inline>
      try {
        const saved = localStorage.getItem("theme");
        if (saved === "dark" || saved === "light") {
          document.documentElement.dataset.theme = saved;
        }
      } catch {
        /* storage blocked: fall back to the system preference */
      }
    </script>
  </head>

  <body>
    <ThemeToggle />
    <main class={centered ? "page page--centered" : "page"}>
      <slot />
    </main>
  </body>
</html>
