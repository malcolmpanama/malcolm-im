---
import Layout from "../../layouts/Layout.astro";
import BackLink from "../../components/BackLink.astro";
import { getEssays, SUBSTACK_URL } from "../../lib/feeds.ts";

const essays = await getEssays();
---

<Layout
  title="Essays"
  description="Essays by Malcolm Daniels on living abroad, moving to Asia and building a life overseas. Published on Substack."
>
  <div class="stack">
    <h1 class="title rise rise-1">Essays</h1>
    <p class="lede rise rise-1">
      Long-form writing on living abroad, published on Substack.
    </p>
  </div>

  {
    essays.length > 0 ? (
      <ul class="feed rise rise-2">
        {essays.map((essay) => (
          <li>
            <a class="feed__item" href={essay.url} target="_blank" rel="noopener noreferrer">
              <span class="feed__title">{essay.title}</span>
              {essay.summary && <span class="feed__summary">{essay.summary}</span>}
              {essay.date && <span class="feed__date">{essay.date}</span>}
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="lede rise rise-2">
        The feed could not be loaded. Read everything on Substack instead.
      </p>
    )
  }

  <div class="footer">
    <a class="card" href={SUBSTACK_URL} target="_blank" rel="noopener noreferrer">
      Subscribe on Substack
    </a>
    <a class="back" href="/">&larr; Back to home</a>
  </div>
</Layout>
