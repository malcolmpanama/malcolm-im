---
import Layout from "../../layouts/Layout.astro";
import BackLink from "../../components/BackLink.astro";
import { quotes } from "../../data/quotes.ts";

// One quote is rendered server side so the page never starts empty.
const first = quotes[Math.floor(Math.random() * quotes.length)];
---

<Layout
  title="Get Inspired"
  description="A rotating set of quotes on discipline, systems and doing the work, collected by Malcolm Daniels."
  centered
>
  <div class="stack">
    <h1 class="title rise rise-1">Get Inspired</h1>

    <blockquote class="quote rise rise-2" data-quote>
      <p class="quote__text" data-quote-text>{first.text}</p>
      {first.author && <cite class="quote__author" data-quote-author>{first.author}</cite>}
      {!first.author && <cite class="quote__author" data-quote-author hidden />}
    </blockquote>

    <button class="button rise rise-3" type="button" data-next>
      Another one
    </button>
  </div>

  <BackLink />
</Layout>

<script>
  import { quotes } from "../../data/quotes.ts";

  const button = document.querySelector<HTMLButtonElement>("[data-next]");
  const text = document.querySelector<HTMLElement>("[data-quote-text]");
  const author = document.querySelector<HTMLElement>("[data-quote-author]");

  button?.addEventListener("click", () => {
    if (!text || !author) return;

    // Never repeat the quote already on screen.
    const others = quotes.filter((quote) => quote.text !== text.textContent);
    const next = others[Math.floor(Math.random() * others.length)];

    text.textContent = next.text;
    author.textContent = next.author ?? "";
    author.hidden = !next.author;
  });
</script>
