---
import Layout from "../../layouts/Layout.astro";
import Cards from "../../components/Cards.astro";
import Card from "../../components/Card.astro";
import Icon from "../../components/Icon.astro";
import BackLink from "../../components/BackLink.astro";
---

<Layout
  title="Contact"
  description="Get in touch with Malcolm Daniels by email, or find him on Instagram, LinkedIn and Discord."
  centered
>
  <div class="stack">
    <h1 class="title rise rise-1">Contact</h1>
    <p class="lede rise rise-2">
      Email is best for work. Everything else is below.
    </p>
  </div>

  <Cards column class="rise rise-3">
    <Card href="mailto:contactmalcolmdd@gmail.com">
      <Icon name="mail" />Email me
    </Card>
    <Card href="https://instagram.com/malcolm_abroad">
      <Icon name="instagram" />Instagram
    </Card>
    <Card href="https://www.linkedin.com/in/malcolmddaniels">
      <Icon name="linkedin" />LinkedIn
    </Card>
    <Card href="https://discord.gg/cper4yEA">
      <Icon name="discord" />Join Discord
    </Card>
  </Cards>

  <BackLink />
</Layout>
