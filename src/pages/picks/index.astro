---
import Layout from "../../layouts/Layout.astro";
import Cards from "../../components/Cards.astro";
import Card from "../../components/Card.astro";
import Icon from "../../components/Icon.astro";
import BackLink from "../../components/BackLink.astro";
---

<Layout
  title="Picks"
  description="Books, music, games and films worth your time, picked by Malcolm Daniels."
  centered
>
  <div class="stack">
    <h1 class="title rise rise-1">Picks</h1>
    <p class="lede rise rise-2">
      The books, records, games and films that were worth the hours.
    </p>
  </div>

  <Cards column class="rise rise-3">
    <Card href="/picks/books"><Icon name="book" />Books</Card>
    <Card href="/picks/music"><Icon name="music" />Music</Card>
    <Card href="/picks/games"><Icon name="game" />Games</Card>
    <Card href="/picks/movies"><Icon name="film" />Movies</Card>
  </Cards>

  <BackLink />
</Layout>
