---
import Layout from "../../../layouts/Layout.astro";
import PickList from "../../../components/PickList.astro";
import BackLink from "../../../components/BackLink.astro";
import { games } from "../../../data/picks.ts";
---

<Layout
  title="Games"
  description="Games that stayed with Malcolm Daniels, finished or still playing, from The Last of Us to Dave the Diver."
>
  <div class="stack">
    <h1 class="title rise rise-1">Games</h1>
    <p class="lede rise rise-1">
      Games that stayed with me, finished or still playing.
    </p>
  </div>

  <PickList items={games} />

  <BackLink href="/picks" label="Back to picks" />
</Layout>
