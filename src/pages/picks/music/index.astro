---
import Layout from "../../../layouts/Layout.astro";
import Cards from "../../../components/Cards.astro";
import Card from "../../../components/Card.astro";
import Icon from "../../../components/Icon.astro";
import BackLink from "../../../components/BackLink.astro";
import { playlists } from "../../../data/picks.ts";
---

<Layout
  title="Music"
  description="Spotify playlists Malcolm Daniels keeps on repeat."
  centered
>
  <div class="stack">
    <h1 class="title rise rise-1">Music</h1>
    <p class="lede rise rise-2">Playlists I keep on repeat.</p>
  </div>

  <Cards column class="rise rise-3">
    {
      playlists.map((playlist) => (
        <Card href={playlist.url}>
          <Icon name="music" />
          {playlist.name}
        </Card>
      ))
    }
  </Cards>

  <BackLink href="/picks" label="Back to picks" />
</Layout>
