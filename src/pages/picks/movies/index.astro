---
import Layout from "../../../layouts/Layout.astro";
import Cards from "../../../components/Cards.astro";
import Card from "../../../components/Card.astro";
import BackLink from "../../../components/BackLink.astro";
import { decades } from "../../../data/picks.ts";
---

<Layout
  title="Movies"
  description="Malcolm Daniels' favourite films, sorted by decade from the 1970s to the 2020s."
  centered
>
  <div class="stack">
    <h1 class="title rise rise-1">Movies</h1>
    <p class="lede rise rise-2">Sorted by decade.</p>
  </div>

  <Cards column class="rise rise-3">
    {
      decades.map((decade) => (
        <Card href={`/picks/movies/${decade.slug}`}>
          {decade.label}
          <span class="count">{decade.films.length}</span>
        </Card>
      ))
    }
  </Cards>

  <BackLink href="/picks" label="Back to picks" />
</Layout>

<style>
  .count {
    color: var(--text-muted);
    font-size: 0.85em;
  }
</style>
