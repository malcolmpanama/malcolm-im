---
import Layout from "../../../layouts/Layout.astro";
import PickList from "../../../components/PickList.astro";
import BackLink from "../../../components/BackLink.astro";
import { books } from "../../../data/picks.ts";
---

<Layout
  title="Books"
  description="The books that shaped how Malcolm Daniels thinks, works and lives, from Cioran and Dostoevsky to Pressfield and Kleon."
>
  <div class="stack">
    <h1 class="title rise rise-1">Books</h1>
    <p class="lede rise rise-1">
      Books that shaped how I think, work and live.
    </p>
  </div>

  <PickList items={books} />

  <BackLink href="/picks" label="Back to picks" />
</Layout>
