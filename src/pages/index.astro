---
import Layout from "../layouts/Layout.astro";
import Cards from "../components/Cards.astro";
import Card from "../components/Card.astro";

// videos and essays now point at on-site pages that render the latest from the
// YouTube and Substack feeds, rather than bouncing straight off the domain.
const links = [
  { href: "/videos", label: "videos" },
  { href: "/essays", label: "essays" },
  { href: "https://malcolm-kez-shop.fourthwall.com/", label: "digital products" },
  { href: "/inspire", label: "get inspired" },
  { href: "/picks", label: "picks" },
  { href: "/contact", label: "contact" },
  { href: "/about", label: "about" },
];
---

<Layout
  title="malcolm.im"
  description="Malcolm Daniels. Creator, consultant and traveler from Panama, living in Asia. Videos, essays, digital products and the books, films, games and music worth your time."
  bare
  centered
>
  <div class="stack">
    <h1 class="home-name rise rise-1">malcolm</h1>
    <p class="lede rise rise-2">
      Creator, consultant and traveler from Panama. A decade in Asia, building
      things and writing about it.
    </p>
  </div>

  <Cards class="rise rise-3">
    {links.map((link) => <Card href={link.href}>{link.label}</Card>)}
  </Cards>
</Layout>

<style>
  .home-name {
    font-size: var(--step-3);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
  }
</style>
