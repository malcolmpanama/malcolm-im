---
import Layout from "../../layouts/Layout.astro";
import BackLink from "../../components/BackLink.astro";

const photos = [
  "/images/malcolm1.jpg",
  "/images/malcolm2.jpg",
  "/images/malcolm3.jpg",
  "/images/malcolm4.jpg",
  "/images/malcolm5.jpg",
  "/images/malcolm6.jpg",
];

// Picked at build time so the portrait is real HTML on first paint.
// Clicking it shuffles, which is where the randomness now lives.
const initial = photos[Math.floor(Math.random() * photos.length)];
---

<Layout
  title="About"
  description="Malcolm Daniels: creator, consultant and traveler from Panama. A decade in Asia building businesses, learning languages and bridging cultures."
>
  <div class="stack">
    <h1 class="title rise rise-1">About</h1>

    <button
      class="portrait-button rise rise-2"
      type="button"
      data-shuffle
      data-photos={JSON.stringify(photos)}
    >
      <img
        class="portrait"
        id="portrait"
        src={initial}
        alt="Malcolm"
        width="400"
        height="400"
        fetchpriority="high"
      />
      <span class="visually-hidden">Show another photo</span>
    </button>

    <div class="prose rise rise-3">
      <p>
        <strong>
          I'm Malcolm, a creator, consultant and traveler from Panama.
        </strong>
      </p>
      <p>
        For over a decade I've lived in Asia, building businesses, learning
        languages and bridging cultures.
      </p>
      <p>I build software, make videos, and promote better thinking.</p>
      <p>
        This space is where I share ideas, recommend books and games, and help
        others live a more intentional, creative, and global life.
      </p>
    </div>
  </div>

  <BackLink />
</Layout>

<style>
  .portrait-button {
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    border-radius: 50%;
    line-height: 0;
  }

  .portrait-button:hover .portrait,
  .portrait-button:focus-visible .portrait {
    border-color: var(--accent);
  }

  .portrait-button .portrait {
    transition: border-color 0.18s ease;
  }
</style>

<script>
  const button = document.querySelector<HTMLButtonElement>("[data-shuffle]");
  const image = document.querySelector<HTMLImageElement>("#portrait");

  if (button && image) {
    const photos: string[] = JSON.parse(button.dataset.photos ?? "[]");

    button.addEventListener("click", () => {
      const others = photos.filter((src) => !image.src.endsWith(src));
      if (others.length === 0) return;
      image.src = others[Math.floor(Math.random() * others.length)];
    });
  }
</script>
